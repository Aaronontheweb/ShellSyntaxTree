    "isUnparseable": false,
    "clauses": [
      {
        "operator": "None",
        "verb": ["cmd1"],
        "args": [],
        "redirects": [],
        "isSubshell": false,
        "isCommandStringWrapped": false
      },
      {
        "operator": "Sequence",
        "verb": ["cmd2"],
        "args": [],
        "redirects": [],
        "isSubshell": false,
        "isCommandStringWrapped": false
      }
    ]
  },
  "notes": "SPEC §4: a leading newline does not create a clause (first clause keeps Operator=None); a trailing newline does not create a phantom clause."
}
