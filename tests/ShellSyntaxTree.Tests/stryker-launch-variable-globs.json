{
  "stryker-config": {
    "project": "ShellSyntaxTree.csproj",
    "configuration": "Release",
    "coverage-analysis": "off",
    "break-on-initial-test-failure": true,
    "test-case-filter": "FullyQualifiedName~LaunchVariableGlobTests",
    "concurrency": 1,
    "reporters": ["progress", "json"],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    }
  }
}
