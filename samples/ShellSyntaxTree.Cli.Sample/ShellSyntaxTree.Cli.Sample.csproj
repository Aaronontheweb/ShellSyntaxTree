<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NetLibVersion)</TargetFramework>
    <RootNamespace>ShellSyntaxTree.Cli.Sample</RootNamespace>
    <!--
      Spec asked for AssemblyName=shellsyntaxtree to give the process a
      friendly name. NuGet restore is case-insensitive about assembly /
      package identity, and that name collides with the library's
      ShellSyntaxTree.dll, producing "Ambiguous project name" at restore.
      Default name kept; invoke via
      'dotnet run project samples/ShellSyntaxTree.Cli.Sample'.
    -->
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShellSyntaxTree\ShellSyntaxTree.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
